// database schema for restolink
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

// models based on the relational schema

model Pelanggan {
  id             String    @id @default(uuid())
  namaPelanggan  String

  // relations
  pesanan        Pesanan[]

  @@map("pelanggan")
}

model Pegawai {
  id             String      @id
  pin            String
  namaPegawai    String
  jabatan        String      // options: kasir, koki, pelayan, pemilik

  // relations
  pesanan        Pesanan[]
  pembayaran     Pembayaran[]
  laporan        Laporan[]
  bahanBaku      BahanBaku[]

  @@map("pegawai")
}

model Meja {
  noMeja         Int        @id
  status         String     @default("TERSEDIA") // options: tersedia, occupied

  // relations
  pesanan        Pesanan[]

  @@map("meja")
}

model Menu {
  id             String    @id @default(uuid())
  namaMenu       String
  kategori       String    // options: food, drinks
  subKategori    String    // options: daging, seafood, coffee, tea, etc.
  harga          Float
  image          String?   // optional image path for the menu item

  // relations
  detailPesanan  DetailPesanan[]
  komposisi      Komposisi[]

  @@map("menu")
}

model BahanBaku {
  id             String      @id @default(uuid())
  namaBahan      String
  statusBahan    String      // options: tersedia, habis

  // relations
  pegawai        Pegawai?    @relation(fields: [idPegawai], references: [id])
  idPegawai      String?
  komposisi      Komposisi[]

  @@map("bahan_baku")
}

model Komposisi {
  idKomposisi    String    @id @default(uuid())
  idMenu         String
  idBahanBaku    String

  // relations
  menu           Menu      @relation(fields: [idMenu], references: [id], onDelete: Cascade)
  bahanBaku      BahanBaku @relation(fields: [idBahanBaku], references: [id], onDelete: Cascade)

  @@map("komposisi")
}

model Pesanan {
  noNota           String            @id @default(uuid())
  tglPesanan       DateTime          @default(now())
  jumlahOrang      Int
  statusPesanan    String            @default("MENUNGGU") // options: menunggu, diproses, siap, selesai, dibatalkan
  statusTagihan    String            @default("UNPAID") // options: unpaid, paid

  // foreign keys
  idPelanggan      String
  idPegawai        String
  noMeja           Int

  // relations
  pelanggan        Pelanggan         @relation(fields: [idPelanggan], references: [id])
  pegawai          Pegawai?          @relation(fields: [idPegawai], references: [id])
  meja             Meja              @relation(fields: [noMeja], references: [noMeja])
  detailPesanan    DetailPesanan[]
  pembayaran       Pembayaran?

  @@map("pesanan")
}

model DetailPesanan {
  idDetail       String    @id @default(uuid())
  jumlahPesanan  Int
  subtotal       Float
  catatan        String?

  // foreign keys
  idMenu         String
  noNota         String

  // relations
  menu           Menu      @relation(fields: [idMenu], references: [id])
  pesanan        Pesanan   @relation(fields: [noNota], references: [noNota], onDelete: Cascade)

  @@map("detail_pesanan")
}

model Pembayaran {
  noKwitansi       String    @id @default(uuid())
  totalBayar       Float
  tglPembayaran    DateTime  @default(now())
  metodePembayaran String    // options: tunai, qris, debit

  // foreign keys
  noNota           String    @unique
  idPegawai        String

  // relations
  pesanan          Pesanan   @relation(fields: [noNota], references: [noNota])
  kasir            Pegawai   @relation(fields: [idPegawai], references: [id])

  @@map("pembayaran")
}

model Laporan {
  idLaporan        String    @id @default(uuid())
  periode          String    // options: harian, mingguan, bulanan, tahunan
  totalPendapatan  Float
  tglLaporan       DateTime  @default(now())

  // foreign keys
  idPegawai        String

  // relations
  pegawai          Pegawai   @relation(fields: [idPegawai], references: [id])

  @@map("laporan")
}